  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "bl": "bunx expo prebuild --clean && cd android && cmd /c gradlew assembleDebug && cd ..",
    "bl2": "bunx expo prebuild --clean && cd android && cmd /c gradlew assembleRelease && cd ..",
    "bl3": "cd android && cmd /c gradlew assembleRelease && cd ..",
    "pre": "bunx expo prebuild --clean && cd android && cmd /c gradlew clean && cd ..",
